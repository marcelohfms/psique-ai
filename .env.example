DEBOUNCE_SECONDS=3

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token

AUTH_SECRET=choose_a_strong_secret

OPENAI_API_KEY=your_openai_key_here

# Meta Cloud API — token permanente e ID do número de telefone
WHATSAPP_TOKEN=your_meta_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_a_strong_verify_token

# App Secret do Meta App Dashboard (Configurações do app → Básico → Chave secreta do app).
# Usado para validar a assinatura X-Hub-Signature-256 de cada webhook recebido.
# OBRIGATÓRIO: sem essa variável, TODO webhook da Meta será rejeitado com 401.
META_APP_SECRET=your_meta_app_secret_here

# Admin endpoints (/admin/pause, /admin/resume, /admin/patch-state, /admin/send-reminders)
ADMIN_SECRET=choose_a_strong_secret

# E-mail de notificações internas da clínica (agendamentos, cancelamentos, documentos)
CLINIC_NOTIFY_EMAIL=clinica@exemplo.com

# Supabase — shared pooler (transaction mode, port 6543)
SUPABASE_CONNECTION_STRING=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_KEY=your_anon_or_service_role_key

# Dashboard
# Obrigatória: o painel recusa TODO acesso se ficar vazia ou como "changeme".
DASHBOARD_PASSWORD=senha_forte_aqui

# Painel da atendente (embutido no Chatwoot via Dashboard App)
ATTENDANT_PANEL_TOKEN=troque-por-um-segredo-aleatorio
# Domínio do Chatwoot que pode embutir o painel em iframe (frame-ancestors do CSP)
CHATWOOT_FRAME_ANCESTOR=https://seu-chatwoot.exemplo.host

# Google Sheets — ID da planilha de solicitações de documentos
# (encontrado na URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_DOC_ID=your_spreadsheet_id_here

# Google Sheets — ID da planilha de comprovantes de pagamento (aba "Pagamentos")
GOOGLE_SHEETS_PAYMENTS_ID=your_payments_spreadsheet_id_here

# Google Drive — ID da pasta para comprovantes de PIX
GOOGLE_DRIVE_PAYMENTS_FOLDER_ID=your_drive_folder_id_here

# Chave PIX da clínica (usada para validar comprovantes enviados pelos pacientes)
PIX_KEY=42006848000178

# Google Drive — ID da pasta para documentos enviados pelo paciente (exames, laudos, etc.)
GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=your_documents_folder_id_here

# Google Drive — contas Google da clínica que podem LER os comprovantes e documentos,
# SEPARADAS POR VÍRGULA. Substitui o antigo link público ("qualquer pessoa com o link"):
# comprovante traz CPF e documento traz dado de saúde, então o arquivo é compartilhado
# só com estas contas (leitura). Quem abrir o link precisa estar logado numa delas.
# Se ficar vazio, o arquivo sobe mas fica só com a conta dona (GOOGLE_REFRESH_TOKEN),
# nunca público — ninguém mais consegue abrir até você preencher aqui.
DRIVE_SHARE_EMAILS=medico1@gmail.com,medico2@gmail.com,clinica@gmail.com

# SMTP — envio de e-mail para notificar médicos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_gmail


# Chatwoot — Agent Bot inbox
# CHATWOOT_BASE_URL / CHATWOOT_ACCOUNT_ID / CHATWOOT_AGENT_BOT_TOKEN também são lidos
# pelo dashboard/ (painel da atendente) para mandar a confirmação de pagamento — configurar
# essas 3 no ambiente de deploy do dashboard também, não só no do bot.
CHATWOOT_BASE_URL=https://evolution-chatwoot.5pqooc.easypanel.host
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_AGENT_BOT_TOKEN=your_agent_bot_token_here
CHATWOOT_USER_TOKEN=your_user_api_token_here  # token de agente humano (perfil → Access Token no Chatwoot)
CHATWOOT_INBOX_ID=1
# Secrets HMAC do Chatwoot, SEPARADOS POR VÍRGULA. Validam a assinatura
# X-Chatwoot-Signature (sha256=<hex> sobre "{timestamp}.{body}").
# Opcional: se vazio, a validação é pulada.
#
# São DOIS emissores entregando no mesmo /chatwoot-webhook, cada um com secret
# próprio e diferente do outro:
#   1. o webhook de conta   → GET /api/v1/accounts/{id}/webhooks    campo `secret`
#   2. o agent bot da Eva   → GET /api/v1/accounts/{id}/agent_bots  campo `secret`
# Configurar só um dos dois rejeita metade do tráfego.
#
# ATENÇÃO: setar isto passa a REJEITAR com 403 tudo que não bater — se faltar um
# secret, a Eva para de responder, em silêncio. Há ainda bug aberto no Chatwoot
# (#13809) em que o `secret` exposto pela API não é o `hmac_token` usado para
# assinar. Use primeiro o DRYRUN abaixo e só promova para cá quando não sobrar
# nenhum `CHATWOOT_SIGNATURE_DRYRUN match=False` no log.
CHATWOOT_WEBHOOK_SECRET=secret_do_webhook,secret_do_agent_bot

# Mesmos valores, em modo observação: calcula, loga qual secret bateu (secret_n)
# e NUNCA rejeita. Ignorado quando CHATWOOT_WEBHOOK_SECRET está setado.
CHATWOOT_WEBHOOK_SECRET_DRYRUN=

# Limite de mensagens de histórico enviadas ao LLM por turno (default: 30)
MAX_HISTORY_MESSAGES=30

# Langfuse (observabilidade — self-hosted)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://langfuse.seudominio.com   # URL do seu servidor self-hosted
